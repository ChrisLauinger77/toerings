#!/bin/sh
# Reinstall npm dependencies when a pull changed package.json or package-lock.json
changed=$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD)

if echo "$changed" | grep -qE '^(package\.json|package-lock\.json)$'; then
  echo "package.json or package-lock.json changed, running npm ci..."
  npm ci
fi
